# IBMS environment configuration
# Copy to .env and adjust values for your environment.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
TIME_ZONE=Africa/Kampala
LOG_LEVEL=INFO

# Database (host values for local tooling / compose defaults)
POSTGRES_DB=ibms
POSTGRES_USER=ibms
POSTGRES_PASSWORD=ibms
POSTGRES_PORT=5434
DATABASE_URL=postgres://ibms:ibms@db:5432/ibms
CACHE_URL=redis://cache:6379/1

# Authentication
JWT_ACCESS_HOURS=12
JWT_REFRESH_DAYS=7
MAX_LOGIN_ATTEMPTS=5
LOCK_MINUTES=15
THROTTLE_ANON=120/min
THROTTLE_USER=5000/hour
THROTTLE_LOGIN=20/min

# CORS / CSRF
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:5173
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
SECURE_REFERRER_POLICY=same-origin

# Business rules
HIGH_VALUE_QUOTE_THRESHOLD=50000
COMMISSION_PAYABLE_DAYS=30
AUTOMATION_RENEWAL_DAYS=90
AUTOMATION_RENEWAL_QUOTE_DAYS=60
AUTOMATION_COLLECTION_INTERVAL_DAYS=7
AUTOMATION_INTERVAL_SECONDS=3600

# Email delivery (console backend by default; use smtp for real delivery)
DEFAULT_FROM_EMAIL=IBMS <no-reply@ibms.local>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false

# SMS delivery (leave blank to disable sending)
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_SENDER_ID=IBMS

# Startup
WAIT_FOR_DB=1
SEED_ON_START=1
COLLECT_STATIC=1

# Frontend (Vite build-time)
VITE_API_URL=/api
